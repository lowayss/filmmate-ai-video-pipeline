{
  "name": "filmmate-desktop",
  "productName": "FilmMate",
  "version": "0.7.2",
  "private": true,
  "main": "main-entry.cjs",
  "scripts": {
    "dev": "electron .",
    "build:mac": "electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "com.loways.filmmate",
    "productName": "FilmMate",
    "files": [
      "main-entry.cjs",
      "main.cjs",
      "project-paths.cjs",
      "python-bridge.cjs",
      "production-state.cjs",
      "preload.cjs",
      "index.html",
      "seedance-facs.js",
      "prompt-languages.js",
      "workspace-ui.css",
      "workspace-ui.js",
      "prompt-handoff.cjs",
      "seedance-skill-binding.cjs",
      "prompt-translation.cjs",
      "prompt-job-client.cjs",
      "micro-shot.css",
      "micro-shot-ui.js",
      "codex-worker.cjs",
      "production-agent-worker.cjs",
      "virtual-camera-core.cjs",
      "virtual-camera-main.cjs",
      "virtual-camera-qr.cjs",
      "virtual-camera-tls.cjs",
      "virtual-camera-ui.js",
      "virtual-camera-ui.css",
      "virtual-camera-pose-ui.js",
      "virtual-camera-pose.css",
      "prompt-bundle.schema.json",
      "production-agent-action.schema.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "core"
      }
    ],
    "mac": {
      "category": "public.app-category.video"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
